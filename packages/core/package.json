{
  "name": "pcb23d",
  "version": "0.1.0",
  "description": "Render KiCad PCBs (.kicad_pcb or a project zip) to 3D PNG images \u2014 top, bottom, and angled views. Pure TypeScript, no WebGL, works in Bun, Node, and browsers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "kicad",
    "pcb",
    "3d",
    "render",
    "png",
    "electronics",
    "gerber"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TensorFleet/pcb23d.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target browser --format esm --external fflate --external earcut && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "earcut": "3.0.1",
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.2.21",
    "typescript": "5.9.2"
  }
}
