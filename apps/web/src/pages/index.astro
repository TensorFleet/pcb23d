---
import Base from "../layouts/Base.astro";
---

<Base
  title="PCB23D — KiCad board to 3D render, in your browser"
  description="Drop a KiCad project zip or .kicad_pcb and get 3D PNG renders: top, bottom, and angled. Runs locally in the browser; also an npm library and a single-binary CLI."
>
  <main>
    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="kicker"><span></span> KiCad → 3D, no upload</p>
        <h1>Drop a board.<br /><em>Get the render.</em></h1>
        <p class="hero-lede">
          Paste a GitHub repo, or drop a project zip or bare <code>.kicad_pcb</code>. You get top,
          bottom, and angled 3D PNGs with silkscreen. Everything renders in this tab.
        </p>
      </div>

      <form class="url-form" id="url-form" autocomplete="off">
        <label class="url-prompt" for="url-input">
          <span class="spark" aria-hidden="true">▦</span>
          <span class="url-field">
            <small>GitHub repo or board URL</small>
            <input
              id="url-input"
              name="url"
              type="text"
              spellcheck="false"
              placeholder="github.com/owner/repo, owner/repo, or a link to a .kicad_pcb"
            />
          </span>
          <button type="submit" aria-label="Fetch and render">→</button>
        </label>
        <p class="url-hint">Public repos only. The board is fetched straight from GitHub by your browser, nothing goes through a server.</p>
      </form>

      <div class="drop" id="drop-zone" tabindex="0" role="button" aria-label="Drop a KiCad zip or board file">
        <div class="drop-board" aria-hidden="true">
          <i></i><i></i><i></i><i></i>
          <span>USB</span>
          <b>MCU</b>
          <em>○</em>
        </div>
        <div class="drop-copy">
          <strong>Drop a <code>.zip</code> or <code>.kicad_pcb</code> here</strong>
          <p>Zips are searched for the project's board. Files stay in your browser.</p>
          <div class="drop-actions">
            <button type="button" id="pick-file" class="btn-primary">Choose file…</button>
            <button type="button" id="try-example" class="btn-ghost">Try an example board</button>
          </div>
          <input id="file-input" type="file" hidden accept=".zip,.kicad_pcb,application/zip" />
        </div>
      </div>
      <p class="form-error" id="error" hidden></p>
    </section>

    <section class="result" id="result" hidden>
      <div class="result-head">
        <div>
          <p class="kicker"><span></span> Render</p>
          <h2 id="result-title">Board</h2>
          <p class="result-meta" id="result-meta"></p>
        </div>
        <div class="result-actions">
          <button type="button" id="download-all" class="btn-primary" disabled>Download all (.zip)</button>
          <button type="button" id="reset" class="btn-ghost">New board</button>
        </div>
      </div>

      <div class="result-body">
        <div class="stage">
          <div class="tabs" id="tabs" role="tablist"></div>
          <div class="canvas-wrap" id="canvas-wrap">
            <img id="preview" alt="3D render of the board" />
            <div class="progress" id="progress"><span></span><em id="progress-text">Parsing board…</em></div>
          </div>
          <div class="stage-foot">
            <span id="preview-info"></span>
            <a id="download-one" class="btn-ghost" download>Download PNG</a>
          </div>
        </div>

        <aside class="controls">
          <h3>Options</h3>
          <label>
            <span>Soldermask</span>
            <select id="opt-mask">
              <option value="">From board</option>
              <option value="green">Green</option>
              <option value="black">Black</option>
              <option value="blue">Blue</option>
              <option value="red">Red</option>
              <option value="white">White</option>
              <option value="purple">Purple</option>
              <option value="yellow">Yellow</option>
            </select>
          </label>
          <label>
            <span>Copper finish</span>
            <select id="opt-finish">
              <option value="">From board</option>
              <option value="gold">Gold (ENIG)</option>
              <option value="silver">Silver (HASL)</option>
              <option value="copper">Bare copper</option>
            </select>
          </label>
          <label>
            <span>Image size</span>
            <select id="opt-size">
              <option value="1200x900">1200 × 900</option>
              <option value="1600x1200" selected>1600 × 1200</option>
              <option value="2400x1800">2400 × 1800</option>
            </select>
          </label>
          <label class="check">
            <input type="checkbox" id="opt-components" checked />
            <span>Component bodies</span>
          </label>
          <label class="check">
            <input type="checkbox" id="opt-models" checked />
            <span>3D models from the KiCad library</span>
          </label>

          <h3>Custom angle</h3>
          <label class="range">
            <span>Azimuth <output id="az-out">-32°</output></span>
            <input type="range" id="opt-az" min="-180" max="180" value="-32" />
          </label>
          <label class="range">
            <span>Elevation <output id="el-out">38°</output></span>
            <input type="range" id="opt-el" min="-89" max="89" value="38" />
          </label>
          <button type="button" id="render-custom" class="btn-ghost">Render custom view</button>
          <p class="hint">Views: top and bottom are orthographic; angled views use a 28° lens.</p>
        </aside>
      </div>
    </section>

    <section class="how" id="how">
      <div class="how-grid">
        <div>
          <p class="kicker"><span></span> How it works</p>
          <h2>A software renderer, not a screenshot.</h2>
        </div>
        <ol>
          <li><b>Parse.</b> The <code>.kicad_pcb</code> S-expression file is read directly: outline, copper, mask openings, silkscreen, drills, footprints.</li>
          <li><b>Composite.</b> Each side becomes a texture: mask over copper, exposed pads in the board's finish, silkscreen on top, holes cut through.</li>
          <li><b>Extrude.</b> The outline is triangulated into a slab. Footprints get their real KiCad library model (WRL meshes, converted once at the edge and cached in R2), project models from the repo (WRL directly, STEP through OpenCascade in a worker), or a box sized from the fab outline.</li>
          <li><b>Rasterize.</b> A z-buffer renderer with supersampling draws each view to PNG. No WebGL, so the same code runs in the CLI.</li>
        </ol>
      </div>
    </section>


    <section class="agent" id="agent">
      <div class="agent-head">
        <div>
          <p class="kicker"><span></span> Copy me for your agent</p>
          <h2>Hand this to Claude, Codex, or Cursor.</h2>
          <p class="lede">
            Paste the block into your coding agent. It downloads the right release binary for the
            machine it is on and renders your KiCad project. Also served as plain text at
            <a href="/agent.md"><code>/agent.md</code></a>.
          </p>
        </div>
        <button type="button" id="copy-agent" class="btn-primary">Copy instructions</button>
      </div>
      <pre class="agent-block" id="agent-block" tabindex="0"># PCB23D for agents — render a KiCad board to 3D PNGs

You are rendering a KiCad PCB to PNG images (top, bottom, angled 3D). Use the `pcb23d`
single-binary CLI. It has no dependencies and runs offline.

## 1. Download the binary for this machine

Releases: https://github.com/TensorFleet/pcb23d/releases/latest
Asset names: pcb23d-linux-x64, pcb23d-linux-arm64, pcb23d-darwin-x64, pcb23d-darwin-arm64, pcb23d-windows-x64.exe

Linux/macOS:

    os=$(uname -s | tr '[:upper:]' '[:lower:]')          # linux | darwin
    arch=$(uname -m); case "$arch" in x86_64) arch=x64;; aarch64|arm64) arch=arm64;; esac
    curl -fsSL -o pcb23d "https://github.com/TensorFleet/pcb23d/releases/latest/download/pcb23d-$&#123;os&#125;-$&#123;arch&#125;"
    chmod +x pcb23d
    ./pcb23d --version

Windows (PowerShell):

    Invoke-WebRequest https://github.com/TensorFleet/pcb23d/releases/latest/download/pcb23d-windows-x64.exe -OutFile pcb23d.exe
    .\pcb23d.exe --version

Alternative without a binary (needs Bun or Node 18+): `bunx pcb23d --help` or `npx pcb23d --help`
are not available; instead `bun add pcb23d` and call `renderPcb()` from TypeScript.

## 2. Pass in the KiCad project

Input is either a `.kicad_pcb` file or a `.zip` of the whole KiCad project. Zips are searched
for the board; the `.kicad_pro`'s sibling `.kicad_pcb` wins, backups are ignored.

    ./pcb23d path/to/project.zip --out renders --json
    ./pcb23d path/to/board.kicad_pcb --out renders --views top,bottom,angle
    ./pcb23d https://github.com/owner/repo --out renders --json      # public GitHub repo, tree URL, or owner/repo

Outputs land in `--out` as `&lt;input-stem>-&lt;view>.png` (transparent background by default).
`--json` prints a summary to stdout: board size in mm, layer count, footprint/track/via counts,
and the path of every PNG written. Exit code 0 on success, 1 if any input failed, 2 for bad flags.

## 3. Useful options

    --views top,bottom,angle,angle-bottom,front,side   # or: all
    --views hero=45/30 --views low=20/12/ortho          # custom azimuth/elevation[/persp|ortho]
    --width 1600 --height 1200 --supersample 2          # image size, anti-aliasing 1-4
    --bg "#ffffff"                                      # or transparent (default)
    --mask black --finish silver --silk white           # override board colours
    --no-components                                     # bare board, no bodies
    --no-models                                         # boxes instead of KiCad library 3D models (offline)

Components use the KiCad library's 3D models (pcbto3d.com's pre-seeded mesh cache, then GitHub
or GitLab, cached under ~/.cache/pcb23d) and EasyEDA models for footprints tagged with an LCSC
part number (--no-lcsc to skip). Project-local models ($&#123;KIPRJMOD&#125;) are read from the project: .wrl/.wrz directly, .step via
OpenCascade WASM (downloaded once, 7 MB, to ~/.cache/pcb23d/occt; --no-step skips it).
Footprints with no usable model are drawn as boxes sized from their fab outline. Only the outer copper layers are visible. GitHub inputs use the anonymous
API (60 requests/hour) unless GITHUB_TOKEN is set.
</pre>
    </section>

    <section class="library" id="library">
      <div class="lib-grid">
        <div>
          <p class="kicker"><span></span> Library &amp; CLI</p>
          <h2>Same engine, three ways.</h2>
          <p class="lede">
            The renderer is the <code>pcb23d</code> npm package. The CLI is that package compiled by Bun
            into one binary per platform.
          </p>
        </div>
        <div class="lib-cards">
          <article>
            <h3>TypeScript</h3>
            <pre><code>import &#123; renderPcb &#125; from "pcb23d";

const out = await renderPcb(zipBytes, &#123;
  views: ["top", "bottom", "angle"],
  width: 1600, height: 1200,
&#125;);
await Bun.write("top.png", out.images.top.png);</code></pre>
            <p><code>bun add pcb23d</code> · works in Bun, Node 18+, Deno, and browsers.</p>
          </article>
          <article>
            <h3>Single binary</h3>
            <pre><code>pcb23d board.zip --out renders
pcb23d *.kicad_pcb --views all --mask black
pcb23d hat.kicad_pcb --views hero=45/30 --bg #ffffff</code></pre>
            <p>Download for Linux, macOS, and Windows from <a href="https://github.com/TensorFleet/pcb23d/releases">GitHub Releases</a>.</p>
          </article>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import { zipSync } from "fflate";
  import { fetchRemoteBoard, isRemoteInput, parseGithubUrl } from "pcb23d";
  import type { RenderRequest, WorkerMessage, BoardSummary } from "../lib/protocol";

  const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel)!;
  const drop = $<HTMLDivElement>("#drop-zone");
  const urlForm = $<HTMLFormElement>("#url-form");
  const urlInput = $<HTMLInputElement>("#url-input");
  const picker = $<HTMLButtonElement>("#pick-file");
  const tryExample = $<HTMLButtonElement>("#try-example");
  const fileInput = $<HTMLInputElement>("#file-input");
  const errorEl = $<HTMLParagraphElement>("#error");
  const result = $<HTMLElement>("#result");
  const resultTitle = $<HTMLHeadingElement>("#result-title");
  const resultMeta = $<HTMLParagraphElement>("#result-meta");
  const tabs = $<HTMLDivElement>("#tabs");
  const preview = $<HTMLImageElement>("#preview");
  const previewInfo = $<HTMLSpanElement>("#preview-info");
  const progress = $<HTMLDivElement>("#progress");
  const progressText = $<HTMLElement>("#progress-text");
  const downloadOne = $<HTMLAnchorElement>("#download-one");
  const downloadAll = $<HTMLButtonElement>("#download-all");
  const resetBtn = $<HTMLButtonElement>("#reset");
  const optMask = $<HTMLSelectElement>("#opt-mask");
  const optFinish = $<HTMLSelectElement>("#opt-finish");
  const optSize = $<HTMLSelectElement>("#opt-size");
  const optComponents = $<HTMLInputElement>("#opt-components");
  const optModels = $<HTMLInputElement>("#opt-models");
  const optAz = $<HTMLInputElement>("#opt-az");
  const optEl = $<HTMLInputElement>("#opt-el");
  const azOut = $<HTMLOutputElement>("#az-out");
  const elOut = $<HTMLOutputElement>("#el-out");
  const renderCustom = $<HTMLButtonElement>("#render-custom");

  const STANDARD_VIEWS: RenderRequest["views"] = [
    { name: "top", spec: "top" },
    { name: "bottom", spec: "bottom" },
    { name: "angle", spec: "angle" },
    { name: "angle-bottom", spec: "angle-bottom" },
  ];
  const LABELS: Record<string, string> = { top: "Top", bottom: "Bottom", angle: "Angle", "angle-bottom": "Angle (bottom)", custom: "Custom" };

  let worker: Worker | null = null;
  let requestId = 0;
  let stem = "board";
  let board: BoardSummary | null = null;
  const images = new Map<string, { blob: Blob; url: string; width: number; height: number; ms: number }>();
  let active = "angle";
  let preferred = "angle";

  function getWorker(): Worker {
    if (worker) return worker;
    worker = new Worker(new URL("../lib/render.worker.ts", import.meta.url), { type: "module" });
    worker.onmessage = (event: MessageEvent<WorkerMessage>) => onMessage(event.data);
    worker.onerror = (event) => showError(`renderer crashed: ${event.message}`);
    return worker;
  }

  function showError(message: string) {
    errorEl.hidden = false;
    errorEl.textContent = message;
    progress.hidden = true;
  }

  function sceneOptions(): RenderRequest["scene"] {
    return {
      ...(optMask.value ? { maskColor: optMask.value } : {}),
      ...(optFinish.value ? { copperFinish: optFinish.value } : {}),
      components: optComponents.checked,
      models: optModels.checked,
      pixelsPerMm: 16,
    };
  }

  function size(): [number, number] {
    const [w, h] = optSize.value.split("x").map(Number);
    return [w ?? 1600, h ?? 1200];
  }

  let pendingProject: RenderRequest["project"] | undefined;
  function send(views: RenderRequest["views"], bytes?: ArrayBuffer, fileName?: string) {
    const [width, height] = size();
    const req: RenderRequest = {
      type: "render",
      id: ++requestId,
      ...(bytes ? { bytes } : {}),
      ...(fileName ? { fileName } : {}),
      ...(bytes && pendingProject ? { project: pendingProject } : {}),
      views,
      width,
      height,
      supersample: 2,
      scene: sceneOptions(),
    };
    progress.hidden = false;
    progressText.textContent = bytes ? "Parsing board…" : "Rendering…";
    errorEl.hidden = true;
    getWorker().postMessage(req, bytes ? [bytes] : []);
  }

  function onMessage(msg: WorkerMessage) {
    if (msg.id !== requestId) return;
    if (msg.type === "error") {
      showError(msg.message);
      return;
    }
    if (msg.type === "parsed") {
      board = msg.board;
      const s = msg.board.stats;
      resultTitle.textContent = msg.board.title || msg.board.path.split("/").pop() || "Board";
      resultMeta.textContent = `${msg.board.widthMm} × ${msg.board.heightMm} mm · ${msg.board.thickness} mm · ${s.copperLayers} copper layers · ${s.footprints} footprints · ${s.tracks} tracks · ${s.vias} vias${msg.board.outlineFromEdgeCuts ? "" : " · no Edge.Cuts, outline estimated"}`;
      progressText.textContent = "Rendering top…";
      return;
    }
    if (msg.type === "models") {
      progress.hidden = false;
      progressText.textContent = msg.done < msg.total ? `Fetching 3D models ${msg.done}/${msg.total}…` : "Building scene…";
      return;
    }
    if (msg.type === "image") {
      const blob = new Blob([msg.png], { type: "image/png" });
      const prev = images.get(msg.name);
      if (prev) URL.revokeObjectURL(prev.url);
      images.set(msg.name, { blob, url: URL.createObjectURL(blob), width: msg.width, height: msg.height, ms: msg.ms });
      // show the first view that arrives, then switch to the preferred one when it lands
      if (msg.name === preferred || !images.has(active)) show(msg.name);
      else renderTabs();
      const order = ["top", "bottom", "angle", "angle-bottom"];
      const next = order.find((n) => !images.has(n));
      progressText.textContent = next ? `Rendering ${LABELS[next] ?? next}…` : "Finishing…";
      return;
    }
    if (msg.type === "done") {
      progress.hidden = true;
      downloadAll.disabled = images.size === 0;
    }
  }

  function renderTabs() {
    tabs.replaceChildren(
      ...[...images.keys()].map((name) => {
        const b = document.createElement("button");
        b.type = "button";
        b.role = "tab";
        b.textContent = LABELS[name] ?? name;
        b.className = name === active ? "active" : "";
        b.addEventListener("click", () => show(name));
        return b;
      }),
    );
  }

  function show(name: string) {
    const img = images.get(name);
    if (!img) return;
    active = name;
    preview.src = img.url;
    previewInfo.textContent = `${LABELS[name] ?? name} · ${img.width} × ${img.height} · ${img.ms} ms`;
    downloadOne.href = img.url;
    downloadOne.download = `${stem}-${name}.png`;
    renderTabs();
  }

  async function openFile(file: File) {
    const name = file.name;
    if (!/\.(zip|kicad_pcb)$/i.test(name)) {
      showError("Please drop a .zip of a KiCad project or a .kicad_pcb file.");
      return;
    }
    stem = (name.split("/").pop() ?? name).replace(/\.(zip|kicad_pcb)$/i, "");
    for (const img of images.values()) URL.revokeObjectURL(img.url);
    images.clear();
    board = null;
    active = "angle";
    preferred = "angle";
    result.hidden = false;
    resultTitle.textContent = name.split("/").pop() ?? name;
    resultMeta.textContent = "";
    preview.removeAttribute("src");
    previewInfo.textContent = "";
    downloadAll.disabled = true;
    tabs.replaceChildren();
    result.scrollIntoView({ behavior: "smooth", block: "start" });
    send(STANDARD_VIEWS, await file.arrayBuffer(), name);
    pendingProject = undefined;
  }

  async function openUrl(raw: string) {
    const input = raw.trim();
    if (!input) return;
    if (!isRemoteInput(input)) {
      showError("Enter a GitHub URL, owner/repo, or a direct link to a .kicad_pcb or .zip.");
      return;
    }
    const button = urlForm.querySelector<HTMLButtonElement>("button");
    if (button) button.disabled = true;
    errorEl.hidden = true;
    try {
      const remote = await fetchRemoteBoard(input);
      const gh = parseGithubUrl(input);
      pendingProject =
        gh && remote.ref ? { owner: gh.owner, repo: gh.repo, ref: remote.ref, paths: remote.archivePaths } : undefined;
      // keep the repo-relative path so ${KIPRJMOD} models resolve against the right directory
      await openFile(new File([remote.bytes as BlobPart], remote.path));
      history.replaceState(null, "", `#url=${encodeURIComponent(input)}`);
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      showError(/failed to fetch|networkerror|cors/i.test(message) ? `${message}. That host does not allow browser downloads; download the file and drop it here instead.` : message);
    } finally {
      if (button) button.disabled = false;
    }
  }
  urlForm.addEventListener("submit", (e) => {
    e.preventDefault();
    void openUrl(urlInput.value);
  });
  urlInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      void openUrl(urlInput.value);
    }
  });
  {
    const m = /[#&]url=([^&]+)/.exec(location.hash);
    if (m) {
      urlInput.value = decodeURIComponent(m[1]!);
      void openUrl(urlInput.value);
    }
  }

  picker.addEventListener("click", () => fileInput.click());
  fileInput.addEventListener("change", () => {
    const f = fileInput.files?.[0];
    if (f) void openFile(f);
    fileInput.value = "";
  });
  drop.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("button")) return;
    fileInput.click();
  });
  drop.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") fileInput.click();
  });
  for (const target of [drop, document.body]) {
    target.addEventListener("dragover", (e) => {
      e.preventDefault();
      drop.classList.add("dropping");
    });
    target.addEventListener("dragleave", () => drop.classList.remove("dropping"));
    target.addEventListener("drop", (e) => {
      e.preventDefault();
      drop.classList.remove("dropping");
      const f = (e as DragEvent).dataTransfer?.files?.[0];
      if (f) void openFile(f);
    });
  }
  tryExample.addEventListener("click", async () => {
    tryExample.disabled = true;
    try {
      const res = await fetch("/examples/ecc83-pp.kicad_pcb");
      if (!res.ok) throw new Error(`example ${res.status}`);
      await openFile(new File([await res.blob()], "ecc83-pp.kicad_pcb"));
    } catch (error) {
      showError(`could not load the example: ${(error as Error).message}`);
    } finally {
      tryExample.disabled = false;
    }
  });
  resetBtn.addEventListener("click", () => {
    result.hidden = true;
    document.getElementById("top")?.scrollIntoView({ behavior: "smooth" });
  });

  const rerender = () => {
    if (!board) return;
    const views = [...STANDARD_VIEWS, ...(images.has("custom") ? [customView()] : [])];
    send(views);
  };
  optMask.addEventListener("change", rerender);
  optFinish.addEventListener("change", rerender);
  optSize.addEventListener("change", rerender);
  optComponents.addEventListener("change", rerender);
  optModels.addEventListener("change", rerender);
  optAz.addEventListener("input", () => (azOut.value = `${optAz.value}°`));
  optEl.addEventListener("input", () => (elOut.value = `${optEl.value}°`));
  function customView(): RenderRequest["views"][number] {
    return {
      name: "custom",
      spec: { azimuth: Number(optAz.value), elevation: Number(optEl.value), projection: "perspective", fov: 28 },
    };
  }
  renderCustom.addEventListener("click", () => {
    if (!board) return;
    preferred = "custom";
    send([customView()]);
  });

  const copyAgent = $<HTMLButtonElement>("#copy-agent");
  const agentBlock = $<HTMLPreElement>("#agent-block");
  copyAgent.addEventListener("click", async () => {
    const text = agentBlock.textContent ?? "";
    try {
      await navigator.clipboard.writeText(text);
      copyAgent.textContent = "Copied";
    } catch {
      const range = document.createRange();
      range.selectNodeContents(agentBlock);
      getSelection()?.removeAllRanges();
      getSelection()?.addRange(range);
      copyAgent.textContent = "Select-all + copy";
    }
    setTimeout(() => (copyAgent.textContent = "Copy instructions"), 1800);
  });

  downloadAll.addEventListener("click", async () => {
    const entries: Record<string, Uint8Array> = {};
    for (const [name, img] of images) entries[`${stem}-${name}.png`] = new Uint8Array(await img.blob.arrayBuffer());
    const zip = zipSync(entries, { level: 0 });
    const url = URL.createObjectURL(new Blob([zip as BlobPart], { type: "application/zip" }));
    const a = document.createElement("a");
    a.href = url;
    a.download = `${stem}-3d.zip`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 5000);
  });
</script>

<style>
  .hero {
